# Copy this file to `.env` (same directory) and fill in your own credentials.
# `.env` is git-ignored so your secrets never leave your machine.
#
# Setup walkthrough: see README "OAuth credentials" section.

# ── Google Calendar API ─────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID (Desktop app) at
# https://console.cloud.google.com/apis/credentials and add
# `http://127.0.0.1:8889/callback` as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8889/callback

# ── Spotify API ─────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard and add
# `http://127.0.0.1:8888/callback` to the redirect URIs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── YouTube Data API v3 (optional — only needed for video backgrounds) ──────
# Create an API key at https://console.cloud.google.com/apis/credentials.
# Without this, the YouTube background-video feature shows a placeholder.
YOUTUBE_API_KEY=
